# ============================================================================
# 年度最佳游戏知识图谱 · 环境变量样例（env.sample）
# ----------------------------------------------------------------------------
# 用法：
#   1) 复制为本仓库的 .env：   cp .env.sample .env
#   2) 按需修改；.env 已被 .gitignore 忽略，不会进版本库
#   3) 启动容器时自动加载：
#        make run     # docker run --env-file .env
#        make up      # docker-compose 自动读取 .env（web 服务 env_file + 变量替换）
#      本地 uv run（make serve / make insight）也会因 api/config.py 的 env_file=".env" 自动读取。
#
# 所有 GOTY_* 变量均由 api/config.py 的 pydantic-settings（env_prefix="GOTY_"）解析。
# 等号右侧即为「默认值」——不写或留空即采用该默认。
# ============================================================================

# ---- 探索总开关 / 异步任务 ----
# 是否开启「数据探索」SPA（true=开启，false=只读洞察页）
GOTY_ENABLE_EXPLORATION=false
# 探索页的操作口令（留空=不校验；生产建议设一个随机串）
GOTY_EXPLORE_TOKEN=
# 异步任务线程池大小
GOTY_TASK_WORKERS=2
# 待处理任务队列上限（超出返回 429）
GOTY_MAX_PENDING=5

# ---- 安全防护：信任代理 / 限流 / 自动封禁 / 黑名单 ----
# 是否信任 X-Forwarded-For（在反代/负载均衡后设为 true）
GOTY_TRUST_PROXY=true
# 全局限流：单 IP 在 rate_window 秒内最多请求数
GOTY_RATE_LIMIT_MAX=200
GOTY_RATE_WINDOW=60
# 板块级限流：单 IP 在 board_window 秒内最多提交板块数
GOTY_BOARD_LIMIT_MAX=8
GOTY_BOARD_WINDOW=60
# 触发自动封禁的违规次数与封禁时长（秒）
GOTY_AUTOBAN_VIOLATIONS=5
GOTY_AUTOBAN_SECONDS=3600
# 永久黑名单：逗号分隔的 IP 种子（如 "1.2.3.4,5.6.7.8"）
GOTY_BLACKLIST=
# 黑名单文件：每行一个 IP（留空则不使用文件）
GOTY_BLACKLIST_FILE=

# ---- 图后端：networkx（默认，内存）| neo4j（可选，Cypher 查询）----
# 默认走内存 networkx，零依赖、离线可用、即起即用，是 API 的真实数据底座；
# 设为 neo4j 需同时填下方连接信息，并在 docker-compose 加 --profile neo4j 启动 Neo4j 容器。
GOTY_GRAPH_BACKEND=networkx
# Neo4j Bolt 连接串（backend=neo4j 且用容器自带 Neo4j 时改为 bolt://neo4j:7687；
# 若连你自己已有的实例，填其地址，如 bolt://localhost:7687）
GOTY_NEO4J_URI=bolt://localhost:7687
GOTY_NEO4J_USER=neo4j
# Neo4j 密码（backend=neo4j 时必填；容器自带 Neo4j 的密码见下方 NEO4J_PASSWORD）
GOTY_NEO4J_PASSWORD=

# ---- 日志 ----
GOTY_LOG_LEVEL=INFO
# 日志文件路径（留空=输出到 stdout）
GOTY_LOG_FILE=

# ============================================================================
# 以下仅用于「容器化 Neo4j」（docker-compose / scripts/neo4j_*.sh），非 API 变量。
# 不设置则用默认弱密码 password123（仅本地演示用）。
# ============================================================================
# Neo4j 容器密码（格式：neo4j/<密码> 中的密码部分；compose 中会被展开为 neo4j/<此值>）
NEO4J_PASSWORD=password123

# Neo4j 镜像（可选，仅 --profile neo4j 时用到）。
# 默认用国内 ARM64 镜像（适用于 Apple Silicon 且 Docker Hub 拉不动的环境）；
# 若你的环境能正常拉 Docker Hub，可改回官方多架构标签：
#   NEO4J_IMAGE=neo4j:5.26-community
NEO4J_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/neo4j:5.26-linuxarm64
