# ============================================================================
# 年度最佳游戏知识图谱 · 环境变量样例（env.sample）
# ----------------------------------------------------------------------------
# 用法：
#   1) 复制为本仓库的 .env：   cp .env.sample .env
#   2) 按需修改；.env 已被 .gitignore 忽略，不会进版本库
#   3) 启动容器时自动加载：
#        make run     # docker run --env-file .env
#        make up      # docker-compose 自动读取 .env（web 服务 env_file + 变量替换）
#      本地 uv run（make serve / make insight）也会因 api/config.py 的 env_file=".env" 自动读取。
#
# 所有 GOTY_* 变量均由 api/config.py 的 pydantic-settings（env_prefix="GOTY_"）解析。
# 等号右侧即为「默认值」——不写或留空即采用该默认。
# ============================================================================

# ---- 探索总开关 / 异步任务 ----
# 是否开启「数据探索」SPA（true=开启，false=只读洞察页）
GOTY_ENABLE_EXPLORATION=false
# 探索页的操作口令（留空=不校验；生产建议设一个随机串）
GOTY_EXPLORE_TOKEN=
# 异步任务线程池大小
GOTY_TASK_WORKERS=2
# 待处理任务队列上限（超出返回 429）
GOTY_MAX_PENDING=5

# ---- 用户认证 / 会话（默认开启）----
# 是否开启账号体系（注册/登录/会话）。关闭后探索页与计算接口回退匿名流程（auth 守卫整体放行）。
GOTY_AUTH_ENABLED=true
# 是否开放自助注册（false=仅管理员可经 CLI/脚本建号，注册接口整体 403）。
GOTY_AUTH_REGISTRATION_OPEN=true
# 探索页是否需要登录后方可进入（false=即使开启 auth 也不拦截 /explore 导航）。
GOTY_EXPLORE_REQUIRES_AUTH=true
# 用户库 SQLAlchemy URL（sqlite 打通流程；未来换 MySQL/PostgreSQL 仅改此值）。
# 注意：与审计库 GOTY_AUDIT_DB_URL 是两套独立库，请勿共用同一文件。
GOTY_USERS_DB_URL=sqlite:///./data/users.db
# 打印用户库 SQL（调试用）
GOTY_USERS_DB_ECHO=false
# 会话有效期（秒），默认 7 天
GOTY_SESSION_TTL_SECONDS=604800
# 会话 Cookie 名（HttpOnly + SameSite=Lax；仅持随机会话 id，校验在服务端完成）
GOTY_SESSION_COOKIE_NAME=goty_session
# Cookie 是否仅经 HTTPS 下发（生产 https 部署设为 true；本地 http 开发保持 false）
GOTY_SESSION_COOKIE_SECURE=false

# ---- 安全防护：信任代理 / 限流 / 自动封禁 / 黑名单 ----
# 是否信任 X-Forwarded-For（在反代/负载均衡后设为 true）
GOTY_TRUST_PROXY=true
# 全局限流：单 IP 在 rate_window 秒内最多请求数
GOTY_RATE_LIMIT_MAX=200
GOTY_RATE_WINDOW=60
# 板块级限流：单 IP 在 board_window 秒内最多提交板块数
GOTY_BOARD_LIMIT_MAX=8
GOTY_BOARD_WINDOW=60
# 触发自动封禁的违规次数与封禁时长（秒）
GOTY_AUTOBAN_VIOLATIONS=5
GOTY_AUTOBAN_SECONDS=3600
# 永久黑名单：逗号分隔的 IP 种子（如 "1.2.3.4,5.6.7.8"）
GOTY_BLACKLIST=
# 黑名单文件：每行一个 IP（留空则不使用文件）
GOTY_BLACKLIST_FILE=

# ---- 图后端：networkx（默认，内存）| neo4j（可选，Cypher 查询）----
# 默认走内存 networkx，零依赖、离线可用、即起即用，是 API 的真实数据底座；
# 设为 neo4j 需同时填下方连接信息，并在 docker-compose 加 --profile neo4j 启动 Neo4j 容器。
GOTY_GRAPH_BACKEND=networkx
# Neo4j Bolt 连接串（backend=neo4j 且用容器自带 Neo4j 时改为 bolt://neo4j:7687；
# 若连你自己已有的实例，填其地址，如 bolt://localhost:7687）
GOTY_NEO4J_URI=bolt://localhost:7687
GOTY_NEO4J_USER=neo4j
# Neo4j 密码（backend=neo4j 时必填；容器自带 Neo4j 的密码见下方 NEO4J_PASSWORD）
GOTY_NEO4J_PASSWORD=

# ---- 日志 ----
GOTY_LOG_LEVEL=INFO
# 日志文件路径（留空=输出到 stdout）
GOTY_LOG_FILE=

# ---- 请求审计日志（双写：时间轮转文件 + 数据库）----
# 是否开启审计（文件 + 数据库）
GOTY_AUDIT_ENABLED=true
# 审计日志文件（按时间周期轮转，每行一条 JSON；留空=不写文件，仅入库）
GOTY_AUDIT_LOG_FILE=
# 轮转单位（TimedRotatingFileHandler 的 when：midnight 每日 / H 每小时 / D 每天…）
GOTY_AUDIT_ROTATE_WHEN=midnight
# 轮转后保留的备份份数
GOTY_AUDIT_ROTATE_BACKUP=14
# 审计数据库 SQLAlchemy URL（sqlite 打通流程；未来换 MySQL/OLAP 仅改此值，如
# mysql+pymysql://user:pwd@host/goty_audit）
GOTY_AUDIT_DB_URL=sqlite:///./data/audit.db
# 打印审计 SQL（调试用）
GOTY_AUDIT_DB_ECHO=false
# 请求体/响应体截断上限（字节），避免大报文撑爆审计表
GOTY_AUDIT_BODY_MAX_BYTES=8192

# ---- 请求源异常判定（默认策略：单 IP 频率超限即拉黑）----
# 是否开启异常判定
GOTY_ANOMALY_ENABLED=true
# 单 IP 在 anomaly_frequency_window 秒内最多请求数（超过即判异常）
GOTY_ANOMALY_FREQUENCY_MAX=60
# 滑动窗口（秒），默认 1 分钟
GOTY_ANOMALY_FREQUENCY_WINDOW=60
# 命中后封禁时长（秒），默认 24 小时
GOTY_ANOMALY_BAN_SECONDS=86400

# ---- 访问控制：UA 策略（拦截明显爬虫，仅放行真实浏览器）----
# 是否开启「拦截爬虫 UA」（默认开：命中黑名单直接 403，并拦截空 UA）。
# 命中即拦截 python/java/go-http/curl/httpx 等脚本 UA 与空 UA（扫描器特征），
# 仅放行真实浏览器。内部报表接口 /api/admin 前缀豁免 UA 拦截，由令牌守卫独立鉴权，
# 避免运维 curl/脚本被误伤。若调用方都是非浏览器脚本，可设为 false 关闭。
GOTY_BLOCK_BOT_UA=true
# 禁用的 UA 子串（逗号分隔；命中即 403）
GOTY_BOT_UA_BLOCKLIST=python,java,go-http,golang,curl,wget,httpx,requests,scrapy,aiohttp,okhttp,guzzle,node,perl,ruby,php,bot,spider,crawl,slurp,headless,scraper,axios,urllib

# ---- 限流后端可替换（未来接 Redis 等共享限流）----
# 非空则走 RedisLimiter（需先 uv pip install redis）；留空=默认内存 Limiter。
# 示例：redis://localhost:6379/0
GOTY_RATE_LIMIT_REDIS_URL=

# ---- 内部管理接口（站点访问统计报表，不面向用户）----
# GET /api/admin/report 的访问令牌；留空=接口整体禁用（返回 403）。
# 不下发到前端，仅供运维/CLI 经 Authorization: Bearer <token> 或 ?token= 调用。
# 示例：GOTY_ADMIN_TOKEN=$(python -c "import secrets;print(secrets.token_urlsafe(24))")
GOTY_ADMIN_TOKEN=

# ============================================================================
# 以下仅用于「容器化 Neo4j」（docker-compose / scripts/neo4j_*.sh），非 API 变量。
# 不设置则用默认弱密码 password123（仅本地演示用）。
# ============================================================================
# Neo4j 容器密码（格式：neo4j/<密码> 中的密码部分；compose 中会被展开为 neo4j/<此值>）
NEO4J_PASSWORD=password123

# Neo4j 镜像（可选，仅 --profile neo4j 时用到）。
# 默认用国内 ARM64 镜像（适用于 Apple Silicon 且 Docker Hub 拉不动的环境）；
# 若你的环境能正常拉 Docker Hub，可改回官方多架构标签：
#   NEO4J_IMAGE=neo4j:5.26-community
NEO4J_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/neo4j:5.26-linuxarm64
